      "policies": {},
      "checkConstraints": {
        "games_counts": {
          "name": "games_counts",
          "value": "\"games\".\"escapes\" between 0 and (case when mode in ('2v8_survivor', '2v8_killer') then 8 else 4 end)\n        and \"games\".\"survivor_abandons\" between 0 and (case when mode in ('2v8_survivor', '2v8_killer') then 8 else 4 end)\n        and \"games\".\"generators_left\" between 0 and (case when mode in ('2v8_survivor', '2v8_killer') then 8 else 5 end)\n        and (\"games\".\"bots\" is null or \"games\".\"bots\" between 0 and 8)\n        and \"games\".\"ignored_survivors\" between 0 and (case when mode in ('2v8_survivor', '2v8_killer') then 0 else 2 end)"
        },
        "games_event_1v4": {
          "name": "games_event_1v4",
          "value": "\"games\".\"event_id\" is null or not mode in ('2v8_survivor', '2v8_killer')"
        },
        "games_2v8_fields": {
          "name": "games_2v8_fields",
          "value": "(mode in ('2v8_survivor', '2v8_killer')) = (\"games\".\"killer2_id\" is not null) and (mode in ('2v8_survivor', '2v8_killer')) = (\"games\".\"bots\" is not null)"
        },
        "games_party": {
          "name": "games_party",
          "value": "case\n        when mode = '2v8_killer' then \"games\".\"party\" is null\n        when mode in ('2v8_survivor', '2v8_killer') then \"games\".\"party\" is not null\n        else \"games\".\"party\" in ('solo', 'duo', 'trio', 'quatuor', 'viewers')\n      end"
        },
        "games_survivor_fields": {
          "name": "games_survivor_fields",
          "value": "(not mode = '2v8_killer') = (\"games\".\"saw_escaped\" is not null)\n        and (not mode = '2v8_killer') = (\"games\".\"hatch_escape\" is not null)\n        and (not mode = '2v8_killer') = (\"games\".\"hook_skip\" is not null)"
        },
        "games_killer_fields": {
          "name": "games_killer_fields",
          "value": "mode = '2v8_killer' or (\"games\".\"mate_id\" is null\n        and cardinality(\"games\".\"mate_gameplay\") = 0\n        and not 'fairplay' = any(\"games\".\"gameplay\"))"
        },
        "games_survivor_only": {
          "name": "games_survivor_only",
          "value": "not mode = '2v8_killer' or \"games\".\"killer_behavior\" is null"
        }
      },
      "isRLSEnabled": false
    },
